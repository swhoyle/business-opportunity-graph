   "source": [
    "df = query_db(\"\"\"\n",
    "    WITH cte AS (\n",
    "    SELECT\n",
    "        c.city AS entity1,\n",
    "        'City' AS entitytype1,\n",
    "        'ADJACENT_TO' AS predicate,\n",
    "        unnest(c.neighboring_cities) AS entity2,\n",
    "        'City' AS entitytype2,\n",
    "        ST_Union(op.way) AS geom1\n",
    "    FROM city_neighborhoods c\n",
    "    LEFT JOIN osm_planet_socal_2025.osn_names ons\n",
    "        ON c.city = ons.name\n",
    "        AND ons.geom_type = 'polygon'\n",
    "    LEFT JOIN osm_planet_socal_2025.planet_osm_polygon op\n",
    "        ON ons.osm_id = op.osm_id\n",
    "        AND ons.geom_type = 'polygon'\n",
    "    WHERE op.osm_id < 0\n",
    "      AND county = 'San Diego'\n",
    "    GROUP BY c.city, neighboring_cities\n",
    "),\n",
    "centroids AS (\n",
    "    SELECT\n",
    "        entity1,\n",
    "        entitytype1,\n",
    "        predicate,\n",
    "        entity2,\n",
    "        entitytype2,\n",
    "        ST_Centroid(ST_Transform(geom1, 4326)) AS centroid1\n",
    "    FROM cte\n",
    "),\n",
    "centroids2 AS (\n",
    "    -- get centroid for the entity2 city\n",
    "    SELECT\n",
    "        c1.*,\n",
    "        ST_Centroid(ST_Transform(op.way, 4326)) AS centroid2\n",
    "    FROM centroids c1\n",
    "    JOIN osm_planet_socal_2025.osn_names ons\n",
    "        ON c1.entity2 = ons.name\n",
    "        AND ons.geom_type = 'polygon'\n",
    "    JOIN osm_planet_socal_2025.planet_osm_polygon op\n",
    "        ON ons.osm_id = op.osm_id\n",
    "        AND ons.geom_type = 'polygon'\n",
    ")\n",
    "SELECT\n",
    "    entity1,\n",
    "    entitytype1,\n",
    "    centroid1,\n",
    "    predicate,\n",
    "    entity2,\n",
    "    entitytype2,\n",
    "    centroid2,\n",
    "    ST_DistanceSphere(centroid1, centroid2) AS distance_meters\n",
    "FROM centroids2\n",
    "ORDER BY distance_meters;\n",
    "\"\"\")\n",
    "df[\"entity1\"] = df[\"entity1\"].map(dict(zip(city_df[\"name\"], city_df[\"id\"])))\n",
    "df[\"entity2\"] = df[\"entity2\"].map(dict(zip(city_df[\"name\"], city_df[\"id\"])))\n",
    "df = df[df[\"entity1\"].notnull() & df[\"entity2\"].notnull()]\n",
    "df[\"entity1\"] = df[\"entity1\"].astype(int)\n",
    "df[\"entity2\"] = df[\"entity2\"].astype(int)\n",
    "save_df_to_json(df, \"city_adjacent_to_city.json\")\n",
    "df.head()\n"
   ]
  },
