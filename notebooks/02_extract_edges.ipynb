    "df = query_db(\"\"\"\n",
    "WITH cte AS (\n",
    "    SELECT\n",
    "        c.community AS entity1,\n",
    "        'Community' AS entitytype1,\n",
    "        'NEARBY' AS predicate,\n",
    "        unnest(c.nearby_communities) AS entity2,\n",
    "        'Community' AS entitytype2,\n",
    "        ST_Union(op.way) AS geom1\n",
    "    FROM community_neighborhoods c\n",
    "    LEFT JOIN osm_planet_socal_2025.osn_names ons\n",
    "        ON c.community = ons.name\n",
    "        AND ons.geom_type = 'polygon'\n",
    "    LEFT JOIN osm_planet_socal_2025.planet_osm_polygon op\n",
    "        ON ons.osm_id = op.osm_id\n",
    "        AND ons.geom_type = 'polygon'\n",
    "    WHERE ST_YMax(ST_Transform(op.way, 4326)) < 33.4   -- your filter\n",
    "    GROUP BY c.community, nearby_communities\n",
    "),\n",
    "centroids AS (\n",
    "    SELECT\n",
    "        entity1,\n",
    "        entitytype1,\n",
    "        predicate,\n",
    "        entity2,\n",
    "        entitytype2,\n",
    "        ST_Centroid(ST_Transform(geom1, 4326)) AS centroid1\n",
    "    FROM cte\n",
    "),\n",
    "centroids2 AS (\n",
    "    -- get centroid for the entity2 community\n",
    "    SELECT\n",
    "        c1.*,\n",
    "        ST_Centroid(ST_Transform(op.way, 4326)) AS centroid2\n",
    "    FROM centroids c1\n",
    "    JOIN osm_planet_socal_2025.osn_names ons\n",
    "        ON c1.entity2 = ons.name\n",
    "        AND ons.geom_type = 'polygon'\n",
