    "        ON ons.osm_id = op.osm_id\n",
    "        AND ons.geom_type = 'polygon'\n",
    "    WHERE ST_YMax(ST_Transform(op.way, 4326)) < 33.4\n",
    ")\n",
    "SELECT\n",
