    "    predicate,\n",
    "    entity2,\n",
    "    entitytype2,\n",
    "    centroid2,\n",
    "    ST_DistanceSphere(centroid1, centroid2) AS distance_meters\n",
    "FROM centroids2\n",
    "ORDER BY distance_meters;\n",
    "\n",
    "\"\"\")\n",
    "df[\"entity1\"] = df[\"entity1\"].map(dict(zip(community_df[\"name\"], community_df[\"id\"])))\n",
